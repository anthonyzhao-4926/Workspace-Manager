{
  "name": "cursor-workspace",
  "displayName": "Workspace Manager",
  "description": "管理多根 Workspace：从配置路径勾选一级项目新建，支持打开、编辑与删除。适用于 VS Code 与 Cursor。",
  "version": "0.1.41",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:cursorWorkspace.workspaces",
    "onCommand:cursorWorkspace.create",
    "onCommand:cursorWorkspace.refresh",
    "onCommand:cursorWorkspace.open",
    "onCommand:cursorWorkspace.openInNewWindow",
    "onCommand:cursorWorkspace.delete",
    "onCommand:cursorWorkspace.edit",
    "onCommand:cursorWorkspace.editCurrent",
    "onCommand:cursorWorkspace.openStorageFolder",
    "onCommand:cursorWorkspace.pickStoragePath",
    "onCommand:cursorWorkspace.useDefaultStoragePath",
    "onCommand:cursorWorkspace.pickProjectFolder",
    "onCommand:cursorWorkspace.openSettings",
    "onWebviewPanel:cursorWorkspace.create"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Workspace Manager",
      "properties": {
        "cursorWorkspace.projectFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "uniqueItems": true,
          "order": 0,
          "markdownDescription": "插件只扫描这些目录下的第一层文件夹，不递归。\n\n[选择路径](command:cursorWorkspace.pickProjectFolder)"
        },
        "cursorWorkspace.workspaceStoragePath": {
          "type": "string",
          "default": "",
          "order": 1,
          "markdownDescription": "Workspace 文件（`.code-workspace`）存放目录，可直接填写。首次使用会自动填入插件默认路径。\n\n[选择路径](command:cursorWorkspace.pickStoragePath) &nbsp;&nbsp; [默认路径](command:cursorWorkspace.useDefaultStoragePath)"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cursorWorkspace",
          "title": "Workspace Manager",
          "icon": "media/cursor-workspace.svg"
        }
      ]
    },
    "views": {
      "cursorWorkspace": [
        {
          "id": "cursorWorkspace.workspaces",
          "name": "Workspaces"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "cursorWorkspace.workspaces",
        "contents": "尚未保存任何 Workspace。\n[新建 Workspace](command:cursorWorkspace.create)"
      }
    ],
    "commands": [
      {
        "command": "cursorWorkspace.refresh",
        "title": "刷新 Workspace 列表",
        "icon": "$(refresh)"
      },
      {
        "command": "cursorWorkspace.create",
        "title": "新建 Workspace",
        "icon": "$(add)"
      },
      {
        "command": "cursorWorkspace.openSettings",
        "title": "打开设置",
        "icon": "$(gear)"
      },
      {
        "command": "cursorWorkspace.open",
        "title": "打开 Workspace"
      },
      {
        "command": "cursorWorkspace.openInNewWindow",
        "title": "在新窗口打开",
        "icon": "$(empty-window)"
      },
      {
        "command": "cursorWorkspace.edit",
        "title": "编辑 Workspace",
        "icon": "$(edit)"
      },
      {
        "command": "cursorWorkspace.editCurrent",
        "title": "向当前 Workspace 添加项目",
        "icon": "$(star-full)"
      },
      {
        "command": "cursorWorkspace.delete",
        "title": "删除 Workspace",
        "icon": "$(trash)"
      },
      {
        "command": "cursorWorkspace.openStorageFolder",
        "title": "打开 Workspace 存放目录"
      },
      {
        "command": "cursorWorkspace.pickStoragePath",
        "title": "选择工作区目录"
      },
      {
        "command": "cursorWorkspace.useDefaultStoragePath",
        "title": "使用默认工作区目录"
      },
      {
        "command": "cursorWorkspace.pickProjectFolder",
        "title": "选择路径"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cursorWorkspace.editCurrent",
          "when": "view == cursorWorkspace.workspaces && cursorWorkspace.hasCurrent",
          "group": "navigation@0"
        },
        {
          "command": "cursorWorkspace.create",
          "when": "view == cursorWorkspace.workspaces",
          "group": "navigation@1"
        },
        {
          "command": "cursorWorkspace.openSettings",
          "when": "view == cursorWorkspace.workspaces",
          "group": "navigation@2"
        },
        {
          "command": "cursorWorkspace.refresh",
          "when": "view == cursorWorkspace.workspaces",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "cursorWorkspace.edit",
          "when": "view == cursorWorkspace.workspaces && (viewItem == workspace || viewItem == workspaceCurrent)",
          "group": "inline@1"
        },
        {
          "command": "cursorWorkspace.delete",
          "when": "view == cursorWorkspace.workspaces && (viewItem == workspace || viewItem == workspaceCurrent)",
          "group": "inline@2"
        },
        {
          "command": "cursorWorkspace.open",
          "when": "view == cursorWorkspace.workspaces && (viewItem == workspace || viewItem == workspaceCurrent)",
          "group": "1_open"
        },
        {
          "command": "cursorWorkspace.openInNewWindow",
          "when": "view == cursorWorkspace.workspaces && (viewItem == workspace || viewItem == workspaceCurrent)",
          "group": "1_open"
        },
        {
          "command": "cursorWorkspace.edit",
          "when": "view == cursorWorkspace.workspaces && (viewItem == workspace || viewItem == workspaceCurrent)",
          "group": "2_modify"
        },
        {
          "command": "cursorWorkspace.delete",
          "when": "view == cursorWorkspace.workspaces && (viewItem == workspace || viewItem == workspaceCurrent)",
          "group": "2_modify"
        }
      ],
      "commandPalette": [
        {
          "command": "cursorWorkspace.open",
          "when": "false"
        },
        {
          "command": "cursorWorkspace.openInNewWindow",
          "when": "false"
        },
        {
          "command": "cursorWorkspace.edit",
          "when": "false"
        },
        {
          "command": "cursorWorkspace.delete",
          "when": "false"
        },
        {
          "command": "cursorWorkspace.pickProjectFolder",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.3"
  }
}
